{
  "anthropic": {
    "host": "api.anthropic.com",
    "header": "x-api-key",
    "env": "ANTHROPIC_API_KEY",
    "allowed_methods": ["POST"],
    "path_prefixes": ["/v1/"]
  },
  "openai": {
    "host": "api.openai.com",
    "header": "authorization",
    "env": "OPENAI_API_KEY",
    "prefix": "Bearer ",
    "allowed_methods": ["POST"],
    "path_prefixes": ["/v1/"]
  }
}
