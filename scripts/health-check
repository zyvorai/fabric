#!/usr/bin/env bash
# health-check — Deep health check for vmspawnd
#
# Checks: service status, API responsiveness, disk space, database,
# VM states, backup timer, certificate expiry, and system resources.
#
# Exit codes:
#   0 = healthy
#   1 = degraded (warnings)
#   2 = critical (errors)

set -uo pipefail

VMSPAWND_URL="${VMSPAWND_URL:-http://127.0.0.1:9095}"
STATE_DIR="/var/lib/vmspawnd"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

WARNINGS=0
ERRORS=0

ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
warn() { echo -e "  ${YELLOW}▸${NC} $*"; ((WARNINGS++)) || true; }
fail() { echo -e "  ${RED}✗${NC} $*"; ((ERRORS++)) || true; }

echo -e "\n${BOLD}vmspawnd Health Check${NC}\n"

# ── Service ─────────────────────────────────────────────────────────
echo -e "${BOLD}Service${NC}"
if systemctl is-active --quiet vmspawnd 2>/dev/null; then
    ok "vmspawnd service is running"
else
    fail "vmspawnd service is not running"
fi

# ── API ─────────────────────────────────────────────────────────────
echo -e "\n${BOLD}API${NC}"
HTTP_CODE=$(curl -sf -o /dev/null -w "%{http_code}" "$VMSPAWND_URL/api/vms" --max-time 5 2>/dev/null) || HTTP_CODE="000"
if [[ "$HTTP_CODE" =~ ^(200|401)$ ]]; then
    ok "API responding ($VMSPAWND_URL) — HTTP $HTTP_CODE"
else
    fail "API not responding ($VMSPAWND_URL) — HTTP $HTTP_CODE"
fi

LATENCY=$(curl -sf -o /dev/null -w "%{time_total}" "$VMSPAWND_URL/api/vms" --max-time 5 2>/dev/null) || LATENCY="0"
LATENCY_MS=$(echo "$LATENCY" | awk '{printf "%.0f", $1 * 1000}')
if [[ "$LATENCY_MS" -lt 500 ]]; then
    ok "API latency: ${LATENCY_MS}ms"
elif [[ "$LATENCY_MS" -lt 2000 ]]; then
    warn "API latency: ${LATENCY_MS}ms (slow)"
else
    fail "API latency: ${LATENCY_MS}ms (very slow)"
fi

# ── Disk Space ──────────────────────────────────────────────────────
echo -e "\n${BOLD}Disk Space${NC}"
if [[ -d "$STATE_DIR" ]]; then
    USAGE=$(df "$STATE_DIR" | tail -1 | awk '{print $5}' | tr -d '%')
    SIZE=$(du -sh "$STATE_DIR" 2>/dev/null | cut -f1)
    if [[ "$USAGE" -lt 80 ]]; then
        ok "State directory: ${SIZE} (${USAGE}% disk used)"
    elif [[ "$USAGE" -lt 95 ]]; then
        warn "State directory: ${SIZE} (${USAGE}% disk used — getting full)"
    else
        fail "State directory: ${SIZE} (${USAGE}% disk used — CRITICAL)"
    fi

    # Check individual store sizes
    for dir in vm_events audit_logs webhook_deliveries backup_jobs performance; do
        if [[ -d "$STATE_DIR/$dir" ]]; then
            COUNT=$(find "$STATE_DIR/$dir" -name "*.json" 2>/dev/null | wc -l)
            if [[ "$COUNT" -gt 10000 ]]; then
                warn "$dir: $COUNT files (consider running cleanup)"
            elif [[ "$COUNT" -gt 1000 ]]; then
                ok "$dir: $COUNT files"
            fi
        fi
    done
else
    fail "State directory not found: $STATE_DIR"
fi

# ── Database ────────────────────────────────────────────────────────
echo -e "\n${BOLD}Database${NC}"
DB_FILE="$STATE_DIR/auth.db"
if [[ -f "$DB_FILE" ]]; then
    DB_SIZE=$(du -sh "$DB_FILE" 2>/dev/null | cut -f1)
    ok "Auth database: $DB_SIZE"
    if command -v sqlite3 &>/dev/null; then
        INTEGRITY=$(sqlite3 "$DB_FILE" "PRAGMA integrity_check;" 2>/dev/null)
        if [[ "$INTEGRITY" == "ok" ]]; then
            ok "Database integrity: OK"
        else
            fail "Database integrity: FAILED"
        fi
        USER_COUNT=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM users;" 2>/dev/null || echo "?")
        ok "Users: $USER_COUNT"
    fi
else
    warn "Auth database not found (auth may be disabled)"
fi

# ── Credentials ─────────────────────────────────────────────────────
echo -e "\n${BOLD}Credentials${NC}"
for f in .admin_password .jwt_secret; do
    if [[ -f "$STATE_DIR/$f" ]]; then
        PERMS=$(stat -c "%a" "$STATE_DIR/$f" 2>/dev/null || stat -f "%Lp" "$STATE_DIR/$f" 2>/dev/null)
        if [[ "$PERMS" == "600" ]]; then
            ok "$f exists (permissions: $PERMS)"
        else
            warn "$f has wrong permissions: $PERMS (should be 600)"
        fi
    else
        warn "$f not found"
    fi
done

# ── Timers ──────────────────────────────────────────────────────────
echo -e "\n${BOLD}Timers${NC}"
for timer in vmspawnd-backup vmspawnd-cleanup; do
    if systemctl is-active --quiet "${timer}.timer" 2>/dev/null; then
        NEXT=$(systemctl show "${timer}.timer" --property=NextElapseUSecRealtime --value 2>/dev/null | head -1)
        ok "${timer} timer active (next: ${NEXT:-unknown})"
    else
        warn "${timer} timer not active"
    fi
done

# ── System Resources ────────────────────────────────────────────────
echo -e "\n${BOLD}System Resources${NC}"
if [[ -e /dev/kvm ]]; then
    ok "KVM available"
else
    warn "KVM not available (VMs will be slow)"
fi

MEM_AVAIL=$(awk '/MemAvailable/ {printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
MEM_TOTAL=$(awk '/MemTotal/ {printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null || echo "1")
MEM_PCT=$((100 - (MEM_AVAIL * 100 / MEM_TOTAL)))
if [[ "$MEM_PCT" -lt 85 ]]; then
    ok "Memory: ${MEM_AVAIL}MB available (${MEM_PCT}% used)"
elif [[ "$MEM_PCT" -lt 95 ]]; then
    warn "Memory: ${MEM_AVAIL}MB available (${MEM_PCT}% used)"
else
    fail "Memory: ${MEM_AVAIL}MB available (${MEM_PCT}% used — CRITICAL)"
fi

LOAD=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo "0")
CPUS=$(nproc 2>/dev/null || echo "1")
ok "Load average: $LOAD ($CPUS CPUs)"

# ── Summary ─────────────────────────────────────────────────────────
echo ""
if [[ $ERRORS -gt 0 ]]; then
    echo -e "${RED}${BOLD}CRITICAL${NC} — $ERRORS error(s), $WARNINGS warning(s)"
    exit 2
elif [[ $WARNINGS -gt 0 ]]; then
    echo -e "${YELLOW}${BOLD}DEGRADED${NC} — $WARNINGS warning(s)"
    exit 1
else
    echo -e "${GREEN}${BOLD}HEALTHY${NC} — all checks passed"
    exit 0
fi
