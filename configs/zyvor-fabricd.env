# zyvor-fabricd environment configuration
# Place this file at /etc/zyvor-fabricd/zyvor-fabricd.env

# Log level: trace, debug, info, warn, error
# ZYVOR_FABRICD_LOG_LEVEL=info

# Override the config file path
# ZYVOR_FABRICD_CONFIG=/etc/zyvor-fabricd/zyvor-fabricd.toml

# Override listen address
# ZYVOR_FABRICD_LISTEN=0.0.0.0:8080

# JWT signing secret (auto-generated and persisted if not set)
# ZYVOR_FABRICD_JWT_SECRET=your-64-char-secret-here

# Initial admin password — only used when auth.db has no users (first start).
# Deploy scripts: set FABRIC_ADMIN_PASSWORD / ZYVOR_FABRICD_ADMIN_PASSWORD, or
# FABRIC_LAB_DEFAULTS=1 for convenient lab default Admin@321. Otherwise a random
# password is generated into /var/lib/zyvor-fabricd/.admin_password (never silent
# Admin@321). For production, set a strong secret before first start.
# ZYVOR_FABRICD_ADMIN_PASSWORD=
# Backup storage directory (default: /var/lib/zyvor-fabricd/backups)
# ZYVOR_FABRICD_BACKUP_DIR=/var/lib/zyvor-fabricd/backups

# Backup retention in days (default: 7)
# ZYVOR_FABRICD_BACKUP_RETAIN=7

# Default backup type: full or incremental (default: full)
# ZYVOR_FABRICD_BACKUP_TYPE=full
