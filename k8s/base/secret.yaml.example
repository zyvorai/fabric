# Example only — do not apply with real secrets in git.
# Lab deploy scripts create zyvor-fabric-secrets for you.
#
#   kubectl create secret generic zyvor-fabric-secrets \
#     --from-literal=admin-password='YOUR_PASSWORD' \
#     --from-literal=jwt-secret="$(openssl rand -base64 32)" \
#     -n zyvor-fabric
apiVersion: v1
kind: Secret
metadata:
  name: zyvor-fabric-secrets
  namespace: zyvor-fabric
  labels:
    app: zyvor-fabric
type: Opaque
stringData:
  admin-password: "change-me"
  jwt-secret: "change-me-to-a-long-random-string"
