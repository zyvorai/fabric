#!/usr/bin/env bash
# cleanup-store — Clean up old state store entities for vmspawnd
#
# Removes old entries from unbounded collections:
#   - vm_events (older than 7 days)
#   - audit_logs (older than 90 days)
#   - webhook_deliveries (older than 7 days)
#   - schedule_history (older than 30 days)
#   - notification_history (older than 30 days)
#   - backup_jobs (completed, older than 7 days)
#
# Also calls the metrics cleanup API endpoint.
#
# Configuration:
#   VMSPAWND_URL             API endpoint (default: http://127.0.0.1:9095)
#   VMSPAWND_EVENT_RETAIN    Days to keep events (default: 7)
#   VMSPAWND_AUDIT_RETAIN    Days to keep audit logs (default: 90)
#   VMSPAWND_HISTORY_RETAIN  Days to keep history/deliveries (default: 30)

set -euo pipefail

VMSPAWND_URL="${VMSPAWND_URL:-http://127.0.0.1:9095}"
STATE_DIR="/var/lib/vmspawnd"
EVENT_RETAIN="${VMSPAWND_EVENT_RETAIN:-7}"
AUDIT_RETAIN="${VMSPAWND_AUDIT_RETAIN:-90}"
HISTORY_RETAIN="${VMSPAWND_HISTORY_RETAIN:-30}"
LOG_TAG="vmspawnd-cleanup"

log()  { echo "$(date -Iseconds) [$LOG_TAG] $*"; }

TOTAL_DELETED=0

# Clean a state store directory by file age
cleanup_dir() {
    local dir="$1"
    local days="$2"
    local label="$3"

    if [[ ! -d "$STATE_DIR/$dir" ]]; then
        return
    fi

    local count=0
    while IFS= read -r -d '' f; do
        rm -f "$f"
        ((count++)) || true
    done < <(find "$STATE_DIR/$dir" -name "*.json" -mtime +"$days" -print0 2>/dev/null)

    if [[ $count -gt 0 ]]; then
        log "Cleaned $count $label (older than $days days)"
        ((TOTAL_DELETED += count)) || true
    fi
}

log "Starting state store cleanup"

cleanup_dir "vm_events"            "$EVENT_RETAIN"    "events"
cleanup_dir "audit_logs"           "$AUDIT_RETAIN"    "audit logs"
cleanup_dir "webhook_deliveries"   "$HISTORY_RETAIN"  "webhook deliveries"
cleanup_dir "schedule_history"     "$HISTORY_RETAIN"  "schedule history entries"
cleanup_dir "notification_history" "$HISTORY_RETAIN"  "notification history entries"
cleanup_dir "backup_jobs"          "$EVENT_RETAIN"    "backup jobs"
cleanup_dir "scale_events"         "$HISTORY_RETAIN"  "scale events"

# Call metrics cleanup API if vmspawnd is running
if curl -sf "$VMSPAWND_URL/health" &>/dev/null; then
    PASSWORD_FILE="$STATE_DIR/.admin_password"
    if [[ -f "$PASSWORD_FILE" ]]; then
        PASSWORD=$(cat "$PASSWORD_FILE")
        TOKEN=$(curl -sf "$VMSPAWND_URL/api/auth/login" \
            -H "Content-Type: application/json" \
            -d "$(jq -n --arg p "$PASSWORD" '{"username":"admin","password":$p}')" \
            | jq -r '.token // empty')

        if [[ -n "$TOKEN" ]]; then
            RESULT=$(curl -sf "$VMSPAWND_URL/api/system/metrics/cleanup" \
                -X POST \
                -H "Authorization: Bearer $TOKEN" 2>/dev/null) || RESULT=""

            if [[ -n "$RESULT" ]]; then
                METRICS_DELETED=$(echo "$RESULT" | jq -r '.deleted // 0')
                log "Cleaned $METRICS_DELETED performance metrics via API"
                ((TOTAL_DELETED += METRICS_DELETED)) || true
            fi
        fi
    fi
else
    log "vmspawnd not running — skipping metrics API cleanup"
fi

# Clean empty directories
find "$STATE_DIR" -type d -empty -delete 2>/dev/null || true

log "Cleanup complete: $TOTAL_DELETED total items removed"
