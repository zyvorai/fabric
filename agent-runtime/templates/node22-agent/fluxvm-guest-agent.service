# Runs INSIDE the guest image (baked in via build-image's copy_in), not on the host.
# Same unit as fluxvm/systemd/fluxvm-guest-agent.service, kept here so a bake needs only the agent binary.

[Unit]
Description=Zyvor FluxVM in-guest agent (vsock ping/exec/shutdown)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fluxvm-guest-agent
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
