[Unit]
Description=zyvor-fabricd Automated VM Backup
Documentation=https://github.com/ssahani/zyvor-fabric
After=zyvor-fabricd.service
Requires=zyvor-fabricd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/zyvor-fabricd/backup-vms
TimeoutStartSec=3600

# Run as root (needs access to VM images and zyvor-fabricd API)
User=root
Group=root

# Environment
EnvironmentFile=-/etc/zyvor-fabricd/zyvor-fabricd.env
Environment=ZYVOR_FABRICD_URL=http://127.0.0.1:9095

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/zyvor-fabricd

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zyvor-fabricd-backup
