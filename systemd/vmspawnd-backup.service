[Unit]
Description=vmspawnd Automated VM Backup
Documentation=https://github.com/ssahani/zyvor-fabric
After=vmspawnd.service
Requires=vmspawnd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/vmspawnd/backup-vms
TimeoutStartSec=3600

# Run as root (needs access to VM images and vmspawnd API)
User=root
Group=root

# Environment
EnvironmentFile=-/etc/vmspawnd/vmspawnd.env
Environment=VMSPAWND_URL=http://127.0.0.1:9095

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vmspawnd

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmspawnd-backup
