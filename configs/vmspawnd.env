# vmspawnd environment configuration
# Place this file at /etc/vmspawnd/vmspawnd.env

# Log level: trace, debug, info, warn, error
# VSPAWN_LOG_LEVEL=info

# Override the config file path
# VMSPAWND_CONFIG=/etc/vmspawnd/vmspawnd.toml

# Override listen address
# VMSPAWND_LISTEN=0.0.0.0:8080

# JWT signing secret (auto-generated and persisted if not set)
# VMSPAWND_JWT_SECRET=your-64-char-secret-here

# Initial admin password (auto-generated and written to
# /var/lib/vmspawnd/.admin_password if not set). Only used on first startup.
# VMSPAWND_ADMIN_PASSWORD=your-strong-password

# Backup storage directory (default: /var/lib/vmspawnd/backups)
# VMSPAWND_BACKUP_DIR=/var/lib/vmspawnd/backups

# Backup retention in days (default: 7)
# VMSPAWND_BACKUP_RETAIN=7

# Default backup type: full or incremental (default: full)
# VMSPAWND_BACKUP_TYPE=full
