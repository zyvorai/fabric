# ── Main ────────────────────────────────────────────────────────────────
main() {
    ORIGINAL_ARGS=("$@")
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        deps)       cmd_deps "$@" ;;
        build)      cmd_build "$@" ;;
        test)       cmd_test "$@" ;;
        install)    cmd_install "$@" ;;
        uninstall)  cmd_uninstall "$@" ;;
        deploy)     cmd_deploy "$@" ;;
        reinstall)  cmd_reinstall "$@" ;;
        upgrade)    cmd_upgrade "$@" ;;
        backup)     cmd_backup "$@" ;;
        verify)     cmd_verify "$@" ;;
        health)     cmd_health "$@" ;;
        tls)        cmd_tls "$@" ;;
        start)      cmd_start "$@" ;;
        stop)       cmd_stop "$@" ;;
        restart)    cmd_restart "$@" ;;
        status)     cmd_status "$@" ;;
        logs)       cmd_logs "$@" ;;
        password)   cmd_password "$@" ;;
        doctor)     cmd_doctor "$@" ;;
        demo)       cmd_demo "$@" ;;
        help|--help|-h) cmd_help ;;
        *)
            err "Unknown command: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
