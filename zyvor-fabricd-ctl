#!/usr/bin/env bash
# zyvor-fabricd-ctl — Install, manage, and demo the zyvor-fabricd VM management platform
#
# Usage: zyvor-fabricd-ctl <command> [options]
#
# Commands:
#   deps          Install all system dependencies
#   build         Build the backend (and optionally web UI)
#   install       Install zyvor-fabricd to the system
#   uninstall     Remove zyvor-fabricd from the system
#   start         Start the zyvor-fabricd service
#   stop          Stop the zyvor-fabricd service
#   restart       Restart the zyvor-fabricd service
#   status        Show service status
#   logs          Show service logs
#   demo          Run interactive demo (create VM, list, snapshot, etc.)
#   doctor        Check system readiness
#   password      Show the admin password
#   help          Show this help

set -euo pipefail

# ── Colors ──────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ── Globals ─────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
API_URL="${ZYVOR_FABRICD_URL:-http://127.0.0.1:9095}"
TOKEN=""

# ── Helpers ─────────────────────────────────────────────────────────────
info()  { echo -e "${BLUE}▸${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}▸${NC} $*"; }
err()   { echo -e "${RED}✗${NC} $*" >&2; }
step()  { echo -e "\n${BOLD}${CYAN}── $* ──${NC}"; }
need_root() {
    if [[ $EUID -ne 0 ]]; then
        info "Escalating to root..."
        exec sudo "$0" "${ORIGINAL_ARGS[@]}"
    fi
}

detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$ID"
    else
        echo "unknown"
    fi
}

detect_pkg_manager() {
    local distro
    distro=$(detect_distro)
    case "$distro" in
        fedora|rhel|centos|rocky|alma)  echo "dnf" ;;
        debian|ubuntu|linuxmint|pop)    echo "apt" ;;
        opensuse*|sles)                 echo "zypper" ;;
        arch|manjaro)                   echo "pacman" ;;
        *)                              echo "unknown" ;;
    esac
}

# ── deps: Install all system dependencies ───────────────────────────────
cmd_deps() {
    need_root
    step "Installing system dependencies"

    local pkg_mgr
    pkg_mgr=$(detect_pkg_manager)
    local distro
    distro=$(detect_distro)

    info "Detected: $distro (package manager: $pkg_mgr)"

    case "$pkg_mgr" in
        dnf)
            info "Installing packages via dnf..."
            echo ""

            # ── Build dependencies ──
            info "Build tools & libraries..."
            dnf install -y \
                gcc gcc-c++ make git \
                pkg-config \
                openssl-devel \
                systemd-devel \
                dbus-devel \
                || { err "Failed to install build deps"; exit 1; }

            # ── Runtime: VM management ──
            info "VM management tools..."
            dnf install -y \
                systemd-container \
                qemu-img \
                qemu-system-x86-core \
                qemu-char-spice \
                qemu-device-display-virtio-gpu \
                qemu-device-display-virtio-vga \
                qemu-device-usb-redirect \
                edk2-ovmf \
                || { err "Failed to install VM packages"; exit 1; }

            # ── Runtime: TPM & image building ──
            info "TPM support & image tools..."
            dnf install -y \
                swtpm swtpm-tools \
                mkosi \
                || { err "Failed to install TPM/mkosi"; exit 1; }

            # ── Runtime: Networking ──
            info "Networking tools..."
            dnf install -y \
                nftables \
                wireguard-tools \
                socat \
                iproute \
                bridge-utils \
                || { err "Failed to install networking packages"; exit 1; }

            # ── Utilities ──
            info "Utilities..."
            dnf install -y \
                curl jq sqlite pandoc \
                || { err "Failed to install utilities"; exit 1; }

            ok "All Fedora/RHEL packages installed"
            ;;

        apt)
            info "Installing packages via apt..."
            echo ""

            apt-get update -qq || { err "apt-get update failed"; exit 1; }

            # ── Build dependencies ──
            info "Build tools & libraries..."
            apt-get install -y \
                gcc g++ make git \
                pkg-config \
                libssl-dev \
                libsystemd-dev \
                libdbus-1-dev \
                || { err "Failed to install build deps"; exit 1; }

            # ── Runtime: VM management ──
            info "VM management tools..."
            apt-get install -y \
                systemd-container \
                qemu-utils \
                qemu-system-x86 \
                ovmf \
                || { err "Failed to install VM packages"; exit 1; }

            # ── Runtime: TPM & image building ──
            info "TPM support & image tools..."
            apt-get install -y \
                swtpm swtpm-tools \
                || { err "Failed to install TPM packages"; exit 1; }
            # mkosi may not be in all Ubuntu versions
            apt-get install -y mkosi 2>/dev/null || warn "mkosi not available — image building will be limited"

            # ── Runtime: Networking ──
            info "Networking tools..."
            apt-get install -y \
                nftables \
                wireguard-tools \
                socat \
                iproute2 \
                bridge-utils \
                || { err "Failed to install networking packages"; exit 1; }

            # ── Utilities ──
            info "Utilities..."
            apt-get install -y \
                curl jq sqlite3 pandoc \
                || { err "Failed to install utilities"; exit 1; }

            ok "All Ubuntu/Debian packages installed"
            ;;

        zypper)
            info "Installing packages via zypper..."
            echo ""

            zypper install -y \
                gcc gcc-c++ make git \
                pkg-config libopenssl-devel systemd-devel dbus-1-devel \
                systemd-container \
                qemu-tools qemu-x86 qemu-ovmf-x86_64 \
                swtpm mkosi \
                nftables wireguard-tools socat iproute2 bridge-utils \
                curl jq sqlite3 \
                || { err "Failed to install packages"; exit 1; }

            ok "All openSUSE packages installed"
            ;;

        pacman)
            info "Installing packages via pacman..."
            echo ""

            pacman -S --noconfirm --needed \
                gcc make git \
                pkgconf openssl \
                systemd \
                qemu-base edk2-ovmf \
                swtpm mkosi \
                nftables wireguard-tools socat iproute2 bridge-utils \
                curl jq sqlite dbus \
                || { err "Failed to install packages"; exit 1; }

            ok "All Arch Linux packages installed"
            ;;

        *)
            err "Unsupported distribution: $distro"
            echo ""
            echo "Please install the following manually:"
            echo ""
            echo "  Build:    gcc, g++, make, git, pkg-config,"
            echo "            openssl-dev, systemd-dev, dbus-dev"
            echo ""
            echo "  VM:       systemd-container, qemu-img, qemu-system-x86,"
            echo "            edk2-ovmf (UEFI firmware)"
            echo ""
            echo "  TPM:      swtpm, swtpm-tools"
            echo "  Images:   mkosi"
            echo ""
            echo "  Network:  nftables, wireguard-tools, socat,"
            echo "            iproute2, bridge-utils"
            echo ""
            echo "  Utils:    curl, jq, sqlite, pandoc"
            exit 1
            ;;
    esac

    # ── Rust toolchain ──
    step "Rust toolchain"
    if ! command -v cargo &>/dev/null; then
        info "Installing Rust via rustup..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
        # shellcheck source=/dev/null
        source "$HOME/.cargo/env" 2>/dev/null || true
        ok "Rust toolchain installed ($(rustc --version 2>/dev/null || echo 'reload shell'))"
    else
        ok "Rust already installed ($(rustc --version))"
    fi

    # ── Node.js (for web UI) ──
    step "Node.js (for web UI)"
    if ! command -v node &>/dev/null; then
        info "Installing Node.js..."
        case "$pkg_mgr" in
            dnf)    dnf install -y nodejs npm || warn "Node.js install failed" ;;
            apt)    apt-get install -y nodejs npm || warn "Node.js install failed" ;;
            zypper) zypper install -y nodejs npm || warn "Node.js install failed" ;;
            pacman) pacman -S --noconfirm --needed nodejs npm || warn "Node.js install failed" ;;
        esac
        if command -v node &>/dev/null; then
            ok "Node.js installed ($(node --version))"
        else
            warn "Node.js not available — web UI build will be skipped"
        fi
    else
        ok "Node.js already installed ($(node --version))"
    fi

    # ── System services ──
    step "Enabling system services"
    systemctl enable --now systemd-machined.service 2>/dev/null && ok "systemd-machined enabled" || warn "systemd-machined not available"
    systemctl enable --now systemd-networkd.service 2>/dev/null && ok "systemd-networkd enabled" || warn "systemd-networkd not available"
    systemctl enable --now systemd-resolved.service 2>/dev/null && ok "systemd-resolved enabled" || warn "systemd-resolved not available"

    # ── Kernel modules ──
    step "Kernel modules"
    modprobe kvm 2>/dev/null && ok "kvm loaded" || warn "KVM not available (VMs will be slow)"
    if grep -q vmx /proc/cpuinfo 2>/dev/null; then
        modprobe kvm_intel 2>/dev/null && ok "kvm_intel loaded" || true
    elif grep -q svm /proc/cpuinfo 2>/dev/null; then
        modprobe kvm_amd 2>/dev/null && ok "kvm_amd loaded" || true
    fi
    modprobe wireguard 2>/dev/null && ok "wireguard loaded" || warn "WireGuard module not available"
    modprobe nft_masq 2>/dev/null || true
    modprobe vhost_net 2>/dev/null && ok "vhost_net loaded" || true

    # ── Summary ──
    step "Summary"
    echo ""
    echo -e "  ${BOLD}Build deps:${NC}     gcc, make, pkg-config, openssl-dev, systemd-dev, dbus-dev"
    echo -e "  ${BOLD}VM tools:${NC}       systemd-vmspawn, machinectl, qemu-img, OVMF/UEFI"
    echo -e "  ${BOLD}TPM:${NC}            swtpm"
    echo -e "  ${BOLD}Networking:${NC}     nftables, wireguard, socat, iproute2"
    echo -e "  ${BOLD}Rust:${NC}           $(rustc --version 2>/dev/null || echo 'not in PATH — reload shell')"
    echo -e "  ${BOLD}Node.js:${NC}        $(node --version 2>/dev/null || echo 'not installed')"
    echo ""
    ok "All dependencies installed"
    echo ""
    info "Next: run ${BOLD}./zyvorctl build${NC} to build the project"
    info "  Or: run ${BOLD}./zyvor-fabricd-ctl doctor${NC} to verify readiness"
}

# ── build: Build the project ────────────────────────────────────────────
cmd_build() {
    step "Building zyvor-fabricd"

    local build_web=1
    if [[ "${1:-}" == "--no-web" ]]; then
        build_web=0
    fi

    info "Building backend (Rust)..."
    cd "$SCRIPT_DIR/backend"
    cargo build --release 2>&1
    ok "Backend built: target/release/zyvor-fabricd, zyvorctl, zyvorctl-tui"

    if [[ $build_web -eq 1 ]] && [[ -d "$SCRIPT_DIR/web" ]]; then
        if command -v node &>/dev/null; then
            info "Building web UI..."
            cd "$SCRIPT_DIR/web"
            npm install --silent 2>&1 | tail -1
            npm run build 2>&1 | tail -1
            ok "Web UI built"
        else
            warn "Node.js not found — skipping web UI build"
        fi
    fi

    echo ""
    ok "Build complete"
    info "Next: run ${BOLD}sudo ./zyvorctl install${NC} to install"
}

# ── install: Install to the system ──────────────────────────────────────
cmd_install() {
    need_root
    step "Installing zyvor-fabricd"

    # Check if built
    if [[ ! -f "$SCRIPT_DIR/backend/target/release/zyvor-fabricd" ]]; then
        err "Not built yet. Run: ./zyvorctl build"
        exit 1
    fi

    cd "$SCRIPT_DIR"
    make install
    systemctl daemon-reload

    ok "zyvor-fabricd installed"
    echo ""
    info "Start with: ${BOLD}sudo ./zyvorctl start${NC}"
    info "Or enable on boot: ${BOLD}sudo systemctl enable --now zyvor-fabricd${NC}"
}

# ── uninstall: Remove from the system ───────────────────────────────────
cmd_uninstall() {
    need_root
    step "Uninstalling zyvor-fabricd"

    # Stop if running
    if systemctl is-active --quiet zyvor-fabricd 2>/dev/null; then
        info "Stopping zyvor-fabricd..."
        systemctl stop zyvor-fabricd
    fi
    systemctl disable zyvor-fabricd 2>/dev/null || true

    cd "$SCRIPT_DIR"
    make uninstall
    systemctl daemon-reload

    ok "zyvor-fabricd uninstalled"

    echo ""
    warn "State data preserved at /var/lib/zyvor-fabricd"
    warn "To remove all data: ${BOLD}sudo rm -rf /var/lib/zyvor-fabricd${NC}"
}

# ── test: Run test suite ────────────────────────────────────────────────
cmd_test() {
    step "Running test suite"

    cd "$SCRIPT_DIR/backend"
    info "Running cargo test..."
    if cargo test 2>&1; then
        ok "All tests passed"
    else
        err "Some tests failed"
        exit 1
    fi
}

# ── verify: Post-install smoke test ─────────────────────────────────────
cmd_verify() {
    step "Post-Install Verification"
    local failures=0

    # 1. Check service
    info "Checking service..."
    if systemctl is-active --quiet zyvor-fabricd 2>/dev/null; then
        ok "Service is running"
    else
        # Try direct process check
        if pgrep -f "/usr/bin/zyvor-fabricd" &>/dev/null; then
            ok "zyvor-fabricd process is running"
        else
            err "zyvor-fabricd is not running"
            ((failures++)) || true
            echo ""
            echo -e "${RED}Verification failed — service not running${NC}"
            return 1
        fi
    fi

    # 2. Check API responds
    info "Checking API..."
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" "$API_URL/api/vms" --max-time 5 2>/dev/null) || http_code="000"
    if [[ "$http_code" =~ ^(200|401)$ ]]; then
        ok "API responding (HTTP $http_code)"
    else
        err "API not responding (HTTP $http_code)"
        ((failures++)) || true
    fi

    # 3. Check authentication
    info "Checking authentication..."
    local pw_file="/var/lib/zyvor-fabricd/.admin_password"
    if [[ -f "$pw_file" ]]; then
        local password token
        password=$(sudo cat "$pw_file" 2>/dev/null || cat "$pw_file" 2>/dev/null)
        token=$(curl -sf "$API_URL/api/auth/login" \
            -H "Content-Type: application/json" \
            -d "$(jq -n --arg p "$password" '{"username":"admin","password":$p}')" \
            --max-time 5 2>/dev/null | jq -r '.token // empty')

        if [[ -n "$token" ]]; then
            ok "Authentication working"

            # 4. Test VM list endpoint
            info "Checking VM list..."
            local vm_response
            vm_response=$(curl -sf "$API_URL/api/vms" \
                -H "Authorization: Bearer $token" \
                --max-time 5 2>/dev/null)
            if [[ -n "$vm_response" ]]; then
                local vm_count
                vm_count=$(echo "$vm_response" | jq 'if type=="object" then .items|length else length end' 2>/dev/null || echo "0")
                ok "VM list: $vm_count VM(s)"
            else
                err "VM list endpoint failed"
                ((failures++)) || true
            fi

            # 5. Test create + delete VM
            info "Testing VM create/delete..."
            local test_name="verify-$(date +%s)"
            local create_code
            create_code=$(curl -sf -o /dev/null -w "%{http_code}" "$API_URL/api/vms" \
                -H "Authorization: Bearer $token" \
                -H "Content-Type: application/json" \
                -d "{\"name\":\"$test_name\",\"image\":\"/var/lib/zyvor-fabricd/images/test.qcow2\",\"cpus\":1,\"memory\":512}" \
                --max-time 5 2>/dev/null) || create_code="000"

            if [[ "$create_code" =~ ^(200|201)$ ]]; then
                ok "VM create: HTTP $create_code"
                # Clean up
                curl -sf -X DELETE "$API_URL/api/vms/$test_name" \
                    -H "Authorization: Bearer $token" \
                    --max-time 5 -o /dev/null 2>/dev/null
                ok "VM delete: cleaned up"
            else
                warn "VM create: HTTP $create_code (may need a disk image)"
            fi

            # 6. Test backup endpoint
            info "Checking backup API..."
            local backup_code
            backup_code=$(curl -sf -o /dev/null -w "%{http_code}" "$API_URL/api/backups" \
                -H "Authorization: Bearer $token" \
                --max-time 5 2>/dev/null) || backup_code="000"
            if [[ "$backup_code" == "200" ]]; then
                ok "Backup API: HTTP $backup_code"
            else
                warn "Backup API: HTTP $backup_code"
            fi
        else
            err "Authentication failed"
            ((failures++)) || true
        fi
    else
        warn "Password file not found — skipping auth tests"
    fi

    # 7. Backup/cleanup scheduling (in-process, no separate timer units —
    # active whenever zyvor-fabricd itself is running)
    info "Checking scheduled backup/cleanup..."
    if systemctl is-active --quiet zyvor-fabricd 2>/dev/null; then
        ok "backup/cleanup scheduler active (runs inside zyvor-fabricd — daily 2:00 AM / weekly Sun 3:00 AM)"
    else
        warn "zyvor-fabricd not running — scheduled backup/cleanup won't run"
    fi

    # Summary
    echo ""
    if [[ $failures -eq 0 ]]; then
        ok "${GREEN}${BOLD}All verification checks passed${NC}"
    else
        err "${RED}${BOLD}$failures check(s) failed${NC}"
        return 1
    fi
}

# ── deploy: Full automated deployment (deps → build → install → start) ─
cmd_deploy() {
    need_root
    step "Full Deployment"
    echo ""
    echo -e "${BOLD}This will:${NC}"
    echo "  1. Install all system dependencies"
    echo "  2. Build the backend (release mode)"
    echo "  3. Install binaries, configs, and systemd units"
    echo "  4. Start the zyvor-fabricd service"
    echo ""

    cmd_deps "$@"
    echo ""

    # Build as the original user if running via sudo
    if [[ -n "${SUDO_USER:-}" ]]; then
        info "Building as $SUDO_USER..."
        su - "$SUDO_USER" -c "cd '$SCRIPT_DIR' && ./zyvorctl build --no-web"
    else
        cmd_build --no-web
    fi
    echo ""

    cmd_install
    echo ""

    cmd_start
    echo ""

    # Auto-verify
    cmd_verify || true

    step "Deployment Complete"
    echo ""
    echo -e "  ${BOLD}API:${NC}        ${CYAN}$API_URL${NC}"
    echo -e "  ${BOLD}Password:${NC}   ${CYAN}sudo cat /var/lib/zyvor-fabricd/.admin_password${NC}"
    echo -e "  ${BOLD}Status:${NC}     ${CYAN}./zyvor-fabricd-ctl status${NC}"
    echo -e "  ${BOLD}Demo:${NC}       ${CYAN}./zyvor-fabricd-ctl demo${NC}"
    echo -e "  ${BOLD}Logs:${NC}       ${CYAN}sudo journalctl -u zyvor-fabricd -f${NC}"
    echo ""
}

# ── reinstall: Stop → rebuild → reinstall → start ──────────────────────
cmd_reinstall() {
    need_root
    step "Reinstalling zyvor-fabricd"

    # Stop if running
    if systemctl is-active --quiet zyvor-fabricd 2>/dev/null; then
        info "Stopping zyvor-fabricd..."
        systemctl stop zyvor-fabricd
    fi

    # Rebuild
    if [[ -n "${SUDO_USER:-}" ]]; then
        info "Rebuilding as $SUDO_USER..."
        su - "$SUDO_USER" -c "cd '$SCRIPT_DIR' && ./zyvorctl build --no-web"
    else
        cmd_build --no-web
    fi
    echo ""

    # Reinstall
    cd "$SCRIPT_DIR"
    make install
    systemctl daemon-reload

    # Start
    systemctl start zyvor-fabricd
    sleep 1

    if systemctl is-active --quiet zyvor-fabricd; then
        ok "zyvor-fabricd reinstalled and running"
        echo ""
        cmd_verify || true
    else
        err "Failed to start after reinstall. Check: sudo journalctl -u zyvor-fabricd -e"
        exit 1
    fi
}

# ── backup: Run backup now or manage backup timer ───────────────────────
cmd_backup() {
    local subcmd="${1:-now}"

    case "$subcmd" in
        now)
            need_root
            step "Running VM backup now"
            if [[ -x /usr/libexec/zyvor-fabricd/backup-vms ]]; then
                /usr/libexec/zyvor-fabricd/backup-vms
            elif [[ -x "$SCRIPT_DIR/scripts/backup-vms" ]]; then
                "$SCRIPT_DIR/scripts/backup-vms"
            else
                err "Backup script not found. Run: ./zyvorctl install"
                exit 1
            fi
            ;;
        enable|disable)
            warn "There's no longer a separate backup timer to $subcmd — zyvor-fabricd"
            warn "runs its own in-process daily backup at 2:00 AM whenever it's running"
            warn "(see backend/zyvor-fabricd/src/schedulers.rs). Stop the daemon itself"
            warn "if you want to stop scheduled backups."
            ;;
        status)
            echo ""
            if systemctl is-active --quiet zyvor-fabricd 2>/dev/null; then
                ok "zyvor-fabricd is running — daily backup scheduled for 2:00 AM (in-process, no separate timer)"
            else
                warn "zyvor-fabricd is not running under systemd — scheduled backups only run while the daemon is up"
            fi
            echo ""
            info "Backup directory: ${BOLD}/var/lib/zyvor-fabricd/backups${NC}"
            if [[ -d /var/lib/zyvor-fabricd/backups ]]; then
                local count
                count=$(find /var/lib/zyvor-fabricd/backups -name "*.qcow2" 2>/dev/null | wc -l)
                info "Backup files: $count"
                local size
                size=$(du -sh /var/lib/zyvor-fabricd/backups 2>/dev/null | cut -f1)
                info "Total size: ${size:-0}"
            fi
            ;;
        logs)
            journalctl -u zyvor-fabricd-backup -f --no-hostname
            ;;
        *)
            echo "Usage: zyvor-fabricd-ctl backup <now|enable|disable|status|logs>"
            ;;
    esac
}

# ── health: Deep health check ───────────────────────────────────────────
cmd_health() {
    if [[ -x /usr/libexec/zyvor-fabricd/health-check ]]; then
        /usr/libexec/zyvor-fabricd/health-check
    elif [[ -x "$SCRIPT_DIR/scripts/health-check" ]]; then
        "$SCRIPT_DIR/scripts/health-check"
    else
        err "Health check script not found. Run: ./zyvorctl install"
        exit 1
    fi
}

# ── upgrade: Pull, rebuild, reinstall ──────────────────────────────────
cmd_upgrade() {
    need_root
    step "Upgrading zyvor-fabricd"

    # Pull latest code
    if [[ -n "${SUDO_USER:-}" ]]; then
        info "Pulling latest code as $SUDO_USER..."
        su - "$SUDO_USER" -c "cd '$SCRIPT_DIR' && git pull --ff-only"
    else
        cd "$SCRIPT_DIR"
        git pull --ff-only
    fi
    echo ""

    # Reinstall
    cmd_reinstall
}

# ── tls: Generate self-signed TLS certificate ─────────────────────────
cmd_tls() {
    need_root
    step "TLS Certificate Setup"

    local cert_dir="/etc/zyvor-fabricd/tls"
    local cert_file="$cert_dir/server.crt"
    local key_file="$cert_dir/server.key"

    mkdir -p "$cert_dir"

    if [[ -f "$cert_file" && -f "$key_file" ]]; then
        local expiry
        expiry=$(openssl x509 -enddate -noout -in "$cert_file" 2>/dev/null | cut -d= -f2)
        ok "Certificate already exists"
        info "Expires: $expiry"
        info "Cert: $cert_file"
        info "Key:  $key_file"
        echo ""
        read -rp "Regenerate? [y/N] " answer
        if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
            return
        fi
    fi

    local hostname
    hostname=$(hostname -f 2>/dev/null || hostname)

    info "Generating self-signed certificate for $hostname..."

    openssl req -x509 -newkey rsa:4096 \
        -keyout "$key_file" \
        -out "$cert_file" \
        -sha256 -days 365 -nodes \
        -subj "/CN=$hostname/O=zyvor-fabricd" \
        -addext "subjectAltName=DNS:$hostname,DNS:localhost,IP:127.0.0.1" \
        2>/dev/null

    chmod 600 "$key_file"
    chmod 644 "$cert_file"

    ok "Certificate generated"
    info "Cert: $cert_file"
    info "Key:  $key_file"
    info "Valid: 365 days"
    echo ""
    info "To enable TLS, add to /etc/zyvor-fabricd/zyvor-fabricd.toml:"
    echo ""
    echo "  [daemon]"
    echo "  tls_cert = \"$cert_file\""
    echo "  tls_key = \"$key_file\""
    echo ""
    info "Then restart: ${BOLD}./zyvorctl restart${NC}"
}

# ── start/stop/restart/status/logs ──────────────────────────────────────
cmd_start() {
    need_root
    step "Starting zyvor-fabricd"

    if ! command -v zyvor-fabricd &>/dev/null && [[ ! -f /usr/bin/zyvor-fabricd ]]; then
        err "zyvor-fabricd not installed. Run: sudo ./zyvorctl install"
        exit 1
    fi

    systemctl start zyvor-fabricd
    sleep 1

    if systemctl is-active --quiet zyvor-fabricd; then
        ok "zyvor-fabricd is running"
        info "API: ${BOLD}$API_URL${NC}"
        info "Web: ${BOLD}$API_URL${NC}"
        info "Logs: ${BOLD}sudo journalctl -u zyvor-fabricd -f${NC}"
    else
        err "Failed to start. Check: sudo journalctl -u zyvor-fabricd -e"
        exit 1
    fi
}

cmd_stop() {
    need_root
    systemctl stop zyvor-fabricd
    ok "zyvor-fabricd stopped"
}

cmd_restart() {
    need_root
    systemctl restart zyvor-fabricd
    sleep 1
    if systemctl is-active --quiet zyvor-fabricd; then
        ok "zyvor-fabricd restarted"
    else
        err "Failed to restart. Check: sudo journalctl -u zyvor-fabricd -e"
    fi
}

cmd_status() {
    echo ""
    if systemctl is-active --quiet zyvor-fabricd 2>/dev/null; then
        ok "zyvor-fabricd is ${GREEN}running${NC}"
    else
        warn "zyvor-fabricd is ${RED}stopped${NC}"
    fi
    echo ""
    systemctl status zyvor-fabricd --no-pager 2>/dev/null || true
}

cmd_logs() {
    journalctl -u zyvor-fabricd -f --no-hostname "${@}"
}

# ── password: Show admin password ───────────────────────────────────────
cmd_password() {
    local pw_file="/var/lib/zyvor-fabricd/.admin_password"
    if [[ -f "$pw_file" ]]; then
        echo -e "${BOLD}Admin password:${NC} $(sudo cat "$pw_file" 2>/dev/null || cat "$pw_file")"
    else
        warn "Password file not found at $pw_file"
        info "zyvor-fabricd generates the password on first startup"
    fi
}

# ── doctor: Check system readiness ──────────────────────────────────────
cmd_doctor() {
    step "System Readiness Check"
    local issues=0

    # Check OS
    local distro
    distro=$(detect_distro)
    info "Distribution: $distro"

    # Check systemd version
    local sd_ver
    sd_ver=$(systemctl --version 2>/dev/null | head -1 | awk '{print $2}') || sd_ver="unknown"
    if [[ "$sd_ver" =~ ^[0-9]+$ ]] && [[ "$sd_ver" -ge 256 ]]; then
        ok "systemd $sd_ver (>= 256 required)"
    else
        warn "systemd $sd_ver (256+ recommended for systemd-vmspawn)"
        ((issues++)) || true
    fi

    # Check KVM
    if [[ -e /dev/kvm ]]; then
        ok "KVM available (/dev/kvm exists)"
    else
        err "KVM not available — VMs will be very slow"
        ((issues++)) || true
    fi

    # Check required commands
    local cmds=("systemd-vmspawn" "machinectl" "qemu-img" "curl" "jq")
    for cmd in "${cmds[@]}"; do
        if command -v "$cmd" &>/dev/null; then
            ok "$cmd found"
        else
            err "$cmd not found"
            ((issues++)) || true
        fi
    done

    # Check optional commands
    local opt_cmds=("swtpm" "mkosi" "nft" "wg" "socat" "pandoc")
    for cmd in "${opt_cmds[@]}"; do
        if command -v "$cmd" &>/dev/null; then
            ok "$cmd found (optional)"
        else
            warn "$cmd not found (optional — some features may be limited)"
        fi
    done

    # Check Rust toolchain
    if command -v cargo &>/dev/null; then
        ok "Rust $(rustc --version | awk '{print $2}')"
    else
        err "Rust toolchain not installed"
        ((issues++)) || true
    fi

    # Check services
    for svc in systemd-machined systemd-networkd; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            ok "$svc is running"
        else
            warn "$svc is not running"
        fi
    done

    # Check zyvor-fabricd
    if command -v zyvor-fabricd &>/dev/null || [[ -f /usr/bin/zyvor-fabricd ]]; then
        ok "zyvor-fabricd is installed"
    else
        warn "zyvor-fabricd not yet installed"
    fi

    if systemctl is-active --quiet zyvor-fabricd 2>/dev/null; then
        ok "zyvor-fabricd is running"
    else
        warn "zyvor-fabricd is not running"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        ok "System is ready"
    else
        warn "$issues issue(s) found — run ${BOLD}sudo ./zyvor-fabricd-ctl deps${NC} to fix"
    fi
}

# ── API helpers ─────────────────────────────────────────────────────────
api_login() {
    local password
    password=$(sudo cat /var/lib/zyvor-fabricd/.admin_password 2>/dev/null) || {
        err "Cannot read admin password. Is zyvor-fabricd running?"
        return 1
    }

    local payload
    payload=$(jq -n --arg p "$password" '{"username":"admin","password":$p}')
    TOKEN=$(curl -sf "$API_URL/api/auth/login" \
        -H "Content-Type: application/json" \
        -d "$payload" | jq -r '.token // empty')

    if [[ -z "$TOKEN" ]]; then
        err "Login failed"
        return 1
    fi
    ok "Authenticated as admin"
}

api() {
    local method="$1" path="$2"
    shift 2
    curl -sf "$API_URL$path" \
        -X "$method" \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        "$@"
}

demo_pause() {
    echo ""
    echo -e "${CYAN}Press Enter to continue...${NC}"
    read -r
}

# ── demo: Interactive demo ──────────────────────────────────────────────
cmd_demo() {
    step "zyvor-fabricd Interactive Demo"
    echo ""
    echo -e "${BOLD}This demo will:${NC}"
    echo "  1. Log in to the API"
    echo "  2. Show system info and health"
    echo "  3. List VMs"
    echo "  4. Create a demo VM"
    echo "  5. Show VM details"
    echo "  6. Show API capabilities"
    echo "  7. Clean up"
    echo ""

    # Check zyvor-fabricd is running
    if ! curl -sf "$API_URL/health" &>/dev/null; then
        err "zyvor-fabricd is not running at $API_URL"
        info "Start it with: ${BOLD}sudo ./zyvorctl start${NC}"
        exit 1
    fi
    ok "zyvor-fabricd is running at $API_URL"

    demo_pause

    # ── Step 1: Login ──
    step "1. Authentication"
    info "Logging in as admin..."
    api_login || exit 1

    demo_pause

    # ── Step 2: System info ──
    step "2. System Information"
    info "GET /api/system/info"
    api GET /api/system/info | jq '.' 2>/dev/null || info "(system info endpoint)"

    echo ""
    info "GET /health"
    curl -sf "$API_URL/health"
    echo ""

    demo_pause

    # ── Step 3: List VMs ──
    step "3. Current VMs"
    info "GET /api/vms"
    local vms
    vms=$(api GET /api/vms 2>/dev/null) || vms="[]"
    echo "$vms" | jq '.' 2>/dev/null || echo "$vms"

    local vm_count
    vm_count=$(echo "$vms" | jq 'if type == "object" then (.vms // []) | length else length end' 2>/dev/null || echo "0")
    info "Found $vm_count VM(s)"

    demo_pause

    # ── Step 4: Create demo VM ──
    step "4. Create Demo VM"
    local demo_name="demo-vm-$(date +%s)"
    info "POST /api/vms — Creating '$demo_name'"
    local create_result
    create_result=$(api POST /api/vms -d "{
        \"name\": \"$demo_name\",
        \"image\": \"/var/lib/machines/demo.qcow2\",
        \"cpus\": 2,
        \"memory\": 1024
    }" 2>/dev/null) || create_result='{"note": "VM creation requires a disk image"}'
    echo "$create_result" | jq '.' 2>/dev/null || echo "$create_result"

    demo_pause

    # ── Step 5: Show VM details ──
    step "5. VM Details"
    info "GET /api/vms/$demo_name"
    api GET "/api/vms/$demo_name" 2>/dev/null | jq '.' 2>/dev/null || info "VM details (VM may not exist without image)"

    demo_pause

    # ── Step 6: API capabilities ──
    step "6. API Capabilities"
    echo ""
    echo -e "${BOLD}Available API endpoints (sample):${NC}"
    echo ""

    local endpoints=(
        "GET    /api/vms                    List VMs (paginated)"
        "POST   /api/vms                    Create VM"
        "POST   /api/vms/:name/start        Start VM"
        "POST   /api/vms/:name/stop         Stop VM"
        "POST   /api/vms/:name/clone        Clone VM"
        "POST   /api/vms/:name/hibernate    Hibernate VM"
        "POST   /api/vms/:name/snapshots    Create snapshot"
        "POST   /api/vms/:name/disk/resize  Resize disk"
        "POST   /api/vms/apply              Declarative VM spec"
        "GET    /api/machines               List machined containers"
        "GET    /api/storage/pools          List storage pools"
        "GET    /api/affinity-rules         List affinity rules"
        "GET    /api/system/capacity        System capacity"
        "GET    /api/system/ksm             KSM memory dedup status"
        "GET    /api/floating-ips           List floating IPs"
        "GET    /api/dns                    DNS configurations"
        "GET    /api/auth/providers         Auth providers (LDAP/OIDC)"
        "GET    /api/webhooks/deliveries    Webhook delivery status"
        "GET    /api/audit/logs             Audit log"
        "GET    /api/system/rate-limits     Rate limit config"
        "GET    /metrics                    Prometheus metrics"
        "WS     /ws/console/:name           VM console (WebSocket)"
        "WS     /ws/vnc/:name              VNC console (WebSocket)"
    )

    for ep in "${endpoints[@]}"; do
        echo -e "  ${GREEN}${ep}${NC}"
    done

    echo ""
    info "Total: 520+ REST endpoints, 3 WebSocket endpoints"

    demo_pause

    # ── Step 7: Cleanup ──
    step "7. Cleanup"
    info "DELETE /api/vms/$demo_name"
    api DELETE "/api/vms/$demo_name" 2>/dev/null || true
    ok "Demo VM cleaned up"

    echo ""
    step "Demo Complete"
    echo ""
    echo -e "${BOLD}Quick reference:${NC}"
    echo -e "  API:       ${CYAN}$API_URL${NC}"
    echo -e "  Web UI:    ${CYAN}$API_URL${NC}"
    echo -e "  CLI:       ${CYAN}zyvorctl list${NC}"
    echo -e "  TUI:       ${CYAN}zyvorctl-tui${NC}"
    echo -e "  Docs:      ${CYAN}$API_URL/api${NC}"
    echo -e "  Metrics:   ${CYAN}$API_URL/metrics${NC}"
    echo ""
}

