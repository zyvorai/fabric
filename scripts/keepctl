#!/usr/bin/env bash
# Copyright 2026 Zyvor AI Labs · https://zyvor.dev
# SPDX-License-Identifier: Apache-2.0
#
# keepctl — Keep product CLI (Fabric). Talks to agent-runtime REST; FluxVM is
# the cell backend. Same verbs as the API. Not a separate repo.
#
#   keepctl deploy <pack-dir> [--run] [--test] [--dry-run]
#                                   # one command: build, sign (KEEP_POLICY_SEED), deploy a pack.json
#   keepctl bundle <pack-dir>        # write <name>.keeppack.json for the console's Deploy a pack
#   keepctl doctor [--smoke]         # runtime, Keep mode, signers, FluxVM, demos (+ a live CSV cleanup)
#   keepctl create -f agent.json --signature agent.json.sig
#                                   # deploy with signed full manifest in Keep mode
#   keepctl policy show|set|sign …   # signed keep.policy.yaml / agent.json
#   keepctl unwrap-token|unwrap|vault-status  # software vault ceremony (host-env)
#   keepctl user-held-challenge|user-held-complete  # Keep 0.2 scaffold (refused without SNP/TDX)
#   keepctl browser tabs|shot|script|doctor|profile|checkout <session-id> …
#   keepctl session pause|resume <session-id> [--reason vault_fill|operator_watch|taint]
#   keepctl browse replay <session-id>   # download browse.spec.mjs
#   keepctl pack   <path>            # workspace hint + policy + manifest pin
#   keepctl unpack <path>            # restore policy onto an agent
#   keepctl export-token …           # scoped trajectory export (default: none)
#   keepctl cockpit <session-id>     # taint + last decisions JSON
#   keepctl list                     # the use cases this runtime can run
#   keepctl run <use-case> <file>...  # run one or a batch (one cell per file); exits 2 on any outbound connection
#   keepctl trigger list|add-webhook|add-folder|rm|fire …   # start a use case without an upload
#   keepctl grants list|revoke <key>   # model endpoints a use case may send text to (approved once)
#   keepctl artifacts [--use-case <id>] [--since <rfc3339>] [--limit <n>]
#   keepctl diff <older-artifact-id> <newer-artifact-id>   # line diff of two runs
#   keepctl audit [<session-id>] [--limit <n>]             # journal + hash-chain check
#   keepctl approvals [pending|approved|denied]            # approval inbox and history
#
set -euo pipefail

if [[ -n "${KEEP_API:-}" ]]; then
  BASE="$KEEP_API"
elif [[ -n "${ZYVOR_AGENT_URL:-}" ]]; then
  BASE="$ZYVOR_AGENT_URL"
else
  BASE="http://127.0.0.1:9096"
fi

if [[ -n "${KEEP_TOKEN:-}" ]]; then
  AUTH_TOKEN="$KEEP_TOKEN"
elif [[ -n "${ZYVOR_AGENT_TOKEN:-}" ]]; then
  AUTH_TOKEN="$ZYVOR_AGENT_TOKEN"
else
  AUTH_TOKEN=""
fi
usage() {
  sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

api() {
  local method=$1 path=$2; shift 2
  if [[ -n "$AUTH_TOKEN" ]]; then
    curl -fsS -X "$method" -H "Authorization: Bearer ${AUTH_TOKEN}" "$BASE$path" "$@"
  else
    curl -fsS -X "$method" "$BASE$path" "$@"
  fi
}

cmd="${1:-}"
shift || true

case "$cmd" in
  ""|-h|--help) usage 0 ;;

  create)
    file=""
    sig_file=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -f|--file) file=$2; shift 2 ;;
        --signature) sig_file=$2; shift 2 ;;
        *) echo "unknown arg: $1" >&2; usage 1 ;;
      esac
    done
    SIG_ARGS=()
    if [[ -n "$sig_file" ]]; then
      [[ -f "$sig_file" ]] || { echo "missing signature file: $sig_file" >&2; exit 1; }
      SIG_ARGS=(-H "X-Keep-Manifest-Signature: $(tr -d ' \n' <"$sig_file")")
    elif [[ -n "$file" && -f "${file}.sig" ]]; then
      SIG_ARGS=(-H "X-Keep-Manifest-Signature: $(tr -d ' \n' <"${file}.sig")")
    elif [[ -n "${KEEP_MANIFEST_SIGNATURE:-}" ]]; then
      SIG_ARGS=(-H "X-Keep-Manifest-Signature: $KEEP_MANIFEST_SIGNATURE")
    fi
    if [[ -n "$file" ]]; then
      api POST /v1/agents -H 'Content-Type: application/json' "${SIG_ARGS[@]}" --data-binary @"$file"
    else
      api POST /v1/agents -H 'Content-Type: application/json' "${SIG_ARGS[@]}" --data-binary @-
    fi
    echo
    ;;

  deploy|bundle)
    [[ $# -ge 1 ]] || usage 1
    sdk="$(cd "$(dirname "$0")/.." && pwd)/sdk/agent-runtime"
    if [[ ! -d "$sdk/node_modules/esbuild" ]]; then
      echo "install the SDK first: (cd $sdk && npm ci)" >&2
      exit 1
    fi
    if [[ -n "$AUTH_TOKEN" ]]; then
      exec node "$sdk/src/cli.js" pack "$cmd" "$@" --url "$BASE" --token "$AUTH_TOKEN"
    fi
    exec node "$sdk/src/cli.js" pack "$cmd" "$@" --url "$BASE"
    ;;

  doctor)
    smoke=0
    [[ "${1:-}" == "--smoke" ]] && smoke=1
    echo "runtime  $BASE"
    api GET /healthz >/dev/null 2>&1 || { echo "  ✗ /healthz failed: is agent-runtime running and KEEP_API/KEEP_TOKEN right?" >&2; exit 1; }
    echo "  ✓ reachable"
    status=$(api GET /v1/keep/status 2>/dev/null || true)
    if [[ -z "$status" ]]; then
      echo "  ! /v1/keep/status missing: this runtime predates keepctl doctor; upgrade it" >&2
      exit 1
    fi
    rc=0
    echo "$status" | python3 -c '
import json, sys
s = json.load(sys.stdin)
bad = 0
def line(ok, text):
    global bad
    print(("  ✓ " if ok else "  ✗ ") + text)
    bad += 0 if ok else 1
line(s["fluxvm"]["ready"], "FluxVM ready" if s["fluxvm"]["ready"] else "FluxVM not ready: %s" % s["fluxvm"].get("error"))
mode = "Keep mode (signed deploys required)" if s["keep_mode"] else "dev mode (signatures optional)"
line(True, mode)
if s["signature_required"]:
    line(s["trusted_signers"] > 0, "%d trusted signer(s)" % s["trusted_signers"] if s["trusted_signers"] else "no trusted signers: set ZYVOR_AGENT_POLICY_TRUSTED_SIGNERS (pubkey from: fabric-agent pack keys)")
print("  · demo template: %s" % s["demo_template"])
print("  · use cases: %d built-in, %d custom" % (s["demos"]["builtin"], s["demos"]["custom"]))
sys.exit(1 if bad else 0)' || rc=$?
    if [[ "$smoke" == "1" && $rc -eq 0 ]]; then
      echo "==> smoke test: csv-clean on its sample"
      "$(dirname "$0")/keep-demo.sh" csv-clean >/dev/null && echo "  ✓ csv-clean ran, 0 CONNECT" || { echo "  ✗ smoke test failed" >&2; rc=1; }
    fi
    exit $rc
    ;;

  pack)
    out="${1:-}"
    name="${2:-}"
    [[ -n "$out" && -n "$name" ]] || { echo "usage: keepctl pack <dir> <agent>  (needs KEEP_EXPORT_TOKEN with scope pack)" >&2; exit 1; }
    [[ -n "${KEEP_EXPORT_TOKEN:-}" ]] || { echo "set KEEP_EXPORT_TOKEN (keepctl export-token pack)" >&2; exit 1; }
    mkdir -p "$out"
    if [[ -n "$AUTH_TOKEN" ]]; then
      curl -fsS -H "Authorization: Bearer ${AUTH_TOKEN}" -H "X-Keep-Export-Token: $KEEP_EXPORT_TOKEN" \
        "$BASE/v1/agents/${name}/pack" >"$out/pack.json"
    else
      curl -fsS -H "X-Keep-Export-Token: $KEEP_EXPORT_TOKEN" \
        "$BASE/v1/agents/${name}/pack" >"$out/pack.json"
    fi
    KEEPCTL_PACK_OUT="$out" python3 - <<'PY'
import json, pathlib, os
p = pathlib.Path(os.environ["KEEPCTL_PACK_OUT"])
data = json.loads(p.joinpath("pack.json").read_text())
p.joinpath("keep.policy.yaml").write_text(data["policy_yaml"])
p.joinpath("agent.json").write_text(json.dumps(data["agent"], indent=2))
p.joinpath("pack-manifest.json").write_text(json.dumps(data["pack"], indent=2))
notes = data["pack"].get("fluxvm_notes", {})
p.joinpath("FLUXVM_MIGRATE.md").write_text(
    "# FluxVM migrate\n\n" + "\n".join(f"- **{k}**: {v}" for k, v in notes.items()) + "\n"
)
creds = data["pack"].get("credential_names") or []
p.joinpath("vault-names.json").write_text(json.dumps({"credentials": creds}, indent=2))
print("wrote keep.policy.yaml agent.json pack-manifest.json vault-names.json FLUXVM_MIGRATE.md")
PY
    echo "packed $name → $out (secrets NOT included — rebind credentials file on destination)"
    ;;

  unpack)
    dir="${1:-}"
    name="${2:-}"
    [[ -n "$dir" && -n "$name" ]] || { echo "usage: keepctl unpack <dir> <agent> [policy.sig]" >&2; exit 1; }
    [[ -f "$dir/keep.policy.yaml" ]] || { echo "missing $dir/keep.policy.yaml" >&2; exit 1; }
    SIG_ARGS=()
    if [[ -n "${3:-}" ]]; then
      SIG_ARGS=(-H "X-Keep-Policy-Signature: $(tr -d ' \n' <"$3")")
    elif [[ -f "$dir/keep.policy.yaml.sig" ]]; then
      SIG_ARGS=(-H "X-Keep-Policy-Signature: $(tr -d ' \n' <"$dir/keep.policy.yaml.sig")")
    elif [[ -n "${KEEP_POLICY_SIGNATURE:-}" ]]; then
      SIG_ARGS=(-H "X-Keep-Policy-Signature: $KEEP_POLICY_SIGNATURE")
    fi
    api PUT "/v1/agents/${name}/policy" -H 'Content-Type: application/x-yaml' \
      "${SIG_ARGS[@]}" --data-binary @"$dir/keep.policy.yaml"
    echo
    echo "unpacked policy onto $name. Restore qcow2 per FLUXVM_MIGRATE.md; rebind vault secrets on host."
    ;;

  policy)
    sub="${1:-}"; shift || true
    case "$sub" in
      sign)
        file="${1:-}"
        seed="${2:-${KEEP_POLICY_SEED:-}}"
        [[ -n "$file" && -n "$seed" ]] || {
          echo "usage: keepctl policy sign <policy.yaml|agent.json> [seed32hex]" >&2
          echo "  or set KEEP_POLICY_SEED; writes <file>.sig and prints hex sig" >&2
          exit 1
        }
        sign_bin=""
        for c in \
          "${KEEP_SIGN_BIN:-}" \
          "$(dirname "$0")/../agent-runtime/target/debug/examples/keep_sign_policy" \
          "$(dirname "$0")/../agent-runtime/target/release/examples/keep_sign_policy"; do
          [[ -n "$c" && -x "$c" ]] && { sign_bin=$c; break; }
        done
        if [[ -z "$sign_bin" ]]; then
          root="$(cd "$(dirname "$0")/.." && pwd)"
          cargo build --manifest-path "$root/agent-runtime/Cargo.toml" --example keep_sign_policy >&2
          sign_bin="$root/agent-runtime/target/debug/examples/keep_sign_policy"
        fi
        sig=$("$sign_bin" sign "$seed" "$file")
        printf '%s\n' "$sig" | tee "${file}.sig"
        ;;
      show|set)
        name="${1:-}"; shift || true
        [[ -n "$name" ]] || { echo "usage: keepctl policy show|set <agent> [file] [sig]" >&2; exit 1; }
        case "$sub" in
          show)
            api GET "/v1/agents/${name}/policy"
            echo
            ;;
          set)
            file="${1:-}"; shift || true
            [[ -n "$file" ]] || { echo "usage: keepctl policy set <agent> <policy.yaml> [sig-file]" >&2; exit 1; }
            SIG_ARGS=()
            if [[ -n "${1:-}" ]]; then
              SIG_ARGS=(-H "X-Keep-Policy-Signature: $(tr -d ' \n' <"$1")")
            elif [[ -f "${file}.sig" ]]; then
              SIG_ARGS=(-H "X-Keep-Policy-Signature: $(tr -d ' \n' <"${file}.sig")")
            elif [[ -n "${KEEP_POLICY_SIGNATURE:-}" ]]; then
              SIG_ARGS=(-H "X-Keep-Policy-Signature: $KEEP_POLICY_SIGNATURE")
            fi
            api PUT "/v1/agents/${name}/policy" -H 'Content-Type: application/x-yaml' \
              "${SIG_ARGS[@]}" --data-binary @"$file"
            echo
            ;;
        esac
        ;;
      *)
        echo "usage: keepctl policy show|set|sign …" >&2
        exit 1
        ;;
    esac
    ;;

  export-token)
    scope="${1:-}"
    ttl="${2:-3600}"
    [[ -n "$scope" ]] || { echo "usage: keepctl export-token <scope> [ttl_seconds]" >&2; exit 1; }
    api POST /v1/export-tokens -H 'Content-Type: application/json' \
      -d "{\"scope\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$scope"),\"ttl_seconds\":$ttl}"
    echo
    ;;

  unwrap-token)
    scope="${1:-vault}"
    ttl="${2:-3600}"
    api POST /v1/vault/unwrap-tokens -H 'Content-Type: application/json' \
      -d "{\"scope\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$scope"),\"ttl_seconds\":$ttl}"
    echo
    ;;

  unwrap)
    tok="${1:-${KEEP_UNWRAP_TOKEN:-}}"
    [[ -n "$tok" ]] || { echo "usage: keepctl unwrap <token>  (or KEEP_UNWRAP_TOKEN)" >&2; exit 1; }
    api POST /v1/vault/unwrap -H 'Content-Type: application/json' \
      -d "{\"token\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$tok")}"
    echo
    ;;

  vault-status)
    api GET /v1/vault/status
    echo
    ;;

  user-held-challenge)
    ttl="${1:-600}"
    api POST /v1/vault/user-held/challenge -H 'Content-Type: application/json' \
      -d "{\"ttl_seconds\":$ttl}"
    echo
    ;;

  user-held-complete)
    id="${1:-}"
    nonce="${2:-}"
    [[ -n "$id" && -n "$nonce" ]] || {
      echo "usage: keepctl user-held-complete <challenge_id> <nonce>" >&2
      exit 1
    }
    api POST /v1/vault/user-held/complete -H 'Content-Type: application/json' \
      -d "{\"challenge_id\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$id"),\"nonce\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$nonce")}"
    echo
    ;;

  cockpit)
    id="${1:-}"
    [[ -n "$id" ]] || { echo "usage: keepctl cockpit <session-id>" >&2; exit 1; }
    api GET "/v1/sessions/${id}/cockpit"
    echo
    ;;

  browser)
    sub="${1:-}"
    id="${2:-}"
    [[ -n "$sub" && -n "$id" ]] || {
      echo "usage: keepctl browser tabs|shot|script|doctor|profile|checkout <session-id> [seq]" >&2
      exit 1
    }
    case "$sub" in
      tabs|view) api GET "/v1/sessions/${id}/browser/view" ;;
      shot|screenshot) api GET "/v1/sessions/${id}/browser/screenshot" ;;
      script) api GET "/v1/sessions/${id}/browser/script" ;;
      doctor) api GET "/v1/sessions/${id}/browser/doctor" ;;
      profile) api GET "/v1/sessions/${id}/browser/profile" ;;
      checkout)
        seq="${3:-}"
        [[ -n "$seq" ]] || { echo "usage: keepctl browser checkout <session-id> <seq>" >&2; exit 1; }
        api GET "/v1/sessions/${id}/browser/checkout?seq=${seq}"
        ;;
      *)
        echo "usage: keepctl browser tabs|shot|script|doctor|profile|checkout <session-id>" >&2
        exit 1
        ;;
    esac
    echo
    ;;

  session)
    sub="${1:-}"
    id="${2:-}"
    [[ -n "$sub" && -n "$id" ]] || {
      echo "usage: keepctl session pause|resume <session-id> [--reason …]" >&2
      exit 1
    }
    case "$sub" in
      pause)
        shift 2 || true
        reason="operator_watch"
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --reason) reason=$2; shift 2 ;;
            *) shift ;;
          esac
        done
        api POST "/v1/sessions/${id}/agent-pause" -H 'Content-Type: application/json' \
          -d "{\"reason\":$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$reason")}"
        ;;
      resume)
        api POST "/v1/sessions/${id}/agent-resume" -H 'Content-Type: application/json' -d '{}'
        ;;
      *)
        echo "usage: keepctl session pause|resume <session-id>" >&2
        exit 1
        ;;
    esac
    echo
    ;;

  browse)
    sub="${1:-}"
    id="${2:-}"
    [[ "$sub" == "replay" && -n "$id" ]] || {
      echo "usage: keepctl browse replay <session-id>" >&2
      exit 1
    }
    api GET "/v1/sessions/${id}/browser/script"
    echo
    ;;

  list)
    api GET "/v1/demos" | python3 -c '
import json, sys
for d in json.load(sys.stdin)["demos"]:
    print("%-24s .%s  %s" % (d["id"], "/.".join(d["accepts"]), d["description"]))'
    ;;

  run)
    id="${1:-}"
    shift || true
    [[ "$id" =~ ^[a-z0-9-]+$ && $# -ge 1 ]] || {
      echo "usage: keepctl run <use-case> <file>..." >&2
      exit 1
    }
    form=()
    for file in "$@"; do
      [[ -f "$file" ]] || { echo "not a file: $file" >&2; exit 1; }
      form+=(-F "file=@${file}")
    done
    # -f would hide the body of a 207 (some files failed); read the status ourselves.
    tmp=$(mktemp)
    code=$(curl -sS -o "$tmp" -w '%{http_code}' -X POST ${AUTH_TOKEN:+-H "Authorization: Bearer ${AUTH_TOKEN}"} "${form[@]}" "$BASE/v1/demos/${id}")
    python3 -m json.tool <"$tmp" || cat "$tmp"
    conn=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('egress_connects', -1))" "$tmp" 2>/dev/null || echo -1)
    rm -f "$tmp"
    if [[ "$code" != "201" && "$code" != "207" ]]; then
      echo "FAIL: HTTP $code" >&2
      exit 1
    fi
    if [[ "$conn" != "0" ]]; then
      echo "FAIL: egress_connects=$conn" >&2
      exit 2
    fi
    if [[ "$code" == "207" ]]; then
      echo "some files failed (see results above)" >&2
      exit 3
    fi
    ;;

  grants)
    sub="${1:-}"
    case "$sub" in
      list)
        api GET "/v1/model-grants" | python3 -c '
import json, sys
for g in json.load(sys.stdin)["items"]:
    print("%s  %-20s %-24s model=%s credential=%s approved=%s" % (g["key"], g["use_case"], g["host"], g["model"], g["credential"], g["approved_at"][:19]))'
        ;;
      revoke)
        [[ -n "${2:-}" ]] || { echo "usage: keepctl grants revoke <key>" >&2; exit 1; }
        api DELETE "/v1/model-grants/${2}"
        ;;
      *) echo "usage: keepctl grants list|revoke <key>" >&2; exit 1 ;;
    esac
    ;;

  trigger)
    sub="${1:-}"
    shift || true
    case "$sub" in
      list)
        api GET "/v1/triggers" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d.get("watch_root_configured"):
    print("(folder triggers are off: set ZYVOR_AGENT_WATCH_ROOT on the runtime)", file=sys.stderr)
for t in d["items"]:
    where = t["hook"] if t["kind"] == "webhook" else "%s every %s" % (t["dir"], t.get("cron") or ("%ss" % t["interval_seconds"]))
    print("%s  %-8s %-20s runs=%-4s %s%s" % (t["id"], t["kind"], t["use_case"], t["runs"], where, ("  ERROR: " + t["last_error"]) if t.get("last_error") else ""))'
        ;;
      add-webhook)
        uc="${1:-}"
        [[ -n "$uc" ]] || { echo "usage: keepctl trigger add-webhook <use-case>" >&2; exit 1; }
        api POST "/v1/triggers" -H 'content-type: application/json' -d "{\"use_case\":\"${uc}\",\"kind\":\"webhook\"}" | python3 -m json.tool
        echo "The secret is shown once. Keep it; it signs every call." >&2
        ;;
      add-folder)
        uc="${1:-}"; dir="${2:-}"; every="${3:-30}"
        [[ -n "$uc" && -n "$dir" ]] || { echo "usage: keepctl trigger add-folder <use-case> <dir-name> [interval-seconds]" >&2; exit 1; }
        api POST "/v1/triggers" -H 'content-type: application/json' -d "{\"use_case\":\"${uc}\",\"kind\":\"folder\",\"dir\":\"${dir}\",\"interval_seconds\":${every}}" | python3 -m json.tool
        ;;
      rm)
        [[ -n "${1:-}" ]] || { echo "usage: keepctl trigger rm <trigger-id>" >&2; exit 1; }
        api DELETE "/v1/triggers/${1}"
        ;;
      fire)
        id="${1:-}"; secret="${2:-}"; file="${3:-}"
        [[ -n "$id" && -n "$secret" && -f "$file" ]] || { echo "usage: keepctl trigger fire <trigger-id> <secret> <file>" >&2; exit 1; }
        sig=$(openssl dgst -sha256 -hmac "$secret" -hex <"$file" | awk '{print $NF}')
        curl -fsS -X POST "$BASE/v1/triggers/${id}/hook" \
          -H "x-zyvor-signature: sha256=${sig}" -H "x-zyvor-filename: $(basename "$file")" \
          --data-binary "@${file}" | python3 -m json.tool
        ;;
      *) echo "usage: keepctl trigger list|add-webhook|add-folder|rm|fire" >&2; exit 1 ;;
    esac
    ;;

  artifacts)
    qs=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --use-case) qs+=("use_case=$2"); shift 2 ;;
        --since) qs+=("since=$2"); shift 2 ;;
        --limit) qs+=("limit=$2"); shift 2 ;;
        *) echo "unknown arg: $1" >&2; usage 1 ;;
      esac
    done
    query=$(IFS='&'; echo "${qs[*]:-}")
    api GET "/v1/artifacts${query:+?$query}" | python3 -c '
import json, sys
for a in json.load(sys.stdin)["items"]:
    print("%s  %s  %-22s %s" % (a["id"], a["created_at"][:19], (a.get("metadata") or {}).get("demo", a["kind"]), a["title"]))'
    ;;

  diff)
    a="${1:-}"; b="${2:-}"
    [[ -n "$a" && -n "$b" ]] || { echo "usage: keepctl diff <older-artifact-id> <newer-artifact-id>" >&2; exit 1; }
    api GET "/v1/artifacts/${a}/diff/${b}" | python3 -c '
import json, sys
d = json.load(sys.stdin)
s = d["summary"]
print("--- %s  %s" % (d["a"]["title"], d["a"]["created_at"][:19]))
print("+++ %s  %s" % (d["b"]["title"], d["b"]["created_at"][:19]))
for l in d["lines"]:
    print({"same": "  ", "add": "+ ", "del": "- "}[l["op"]] + l["line"])
print("%d added, %d removed, %d unchanged" % (s["added"], s["removed"], s["unchanged"]))'
    ;;

  audit)
    session=""
    limit=50
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --limit) limit=$2; shift 2 ;;
        -*) echo "unknown arg: $1" >&2; usage 1 ;;
        *) session=$1; shift ;;
      esac
    done
    api GET "/v1/audit?limit=${limit}${session:+&session_id=$session}" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for e in d["items"]:
    print(json.dumps(e, sort_keys=True))
print("chain: " + json.dumps(d["chain"], sort_keys=True), file=sys.stderr)'
    ;;

  approvals)
    want="${1:-}"
    api GET "/v1/approvals" | WANT="$want" python3 -c '
import json, os, sys
want = os.environ.get("WANT", "")
for a in json.load(sys.stdin)["items"]:
    if want and a["status"] != want:
        continue
    print("%s  %-9s %-8s %s  %s" % (a["id"], a["status"], a["kind"], a["created_at"][:19], a.get("subject") or ""))'
    ;;

  *)
    echo "unknown command: $cmd" >&2
    usage 1
    ;;
esac
