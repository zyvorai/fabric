[Unit]
Description=zyvor-fabricd - Virtual Machine Management Daemon
Documentation=https://github.com/ssahani/zyvor-fabric
After=network-online.target systemd-machined.service systemd-networkd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zyvor-fabricd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# Watchdog requires sd_notify(WATCHDOG=1) from the daemon; enable once implemented.
# WatchdogSec=60s

# Environment
Environment=ZYVOR_FABRICD_LOG_LEVEL=info
EnvironmentFile=-/etc/zyvor-fabricd/zyvor-fabricd.env

# Credentials
User=root
Group=root

# Filesystem access
ReadWritePaths=/var/lib/zyvor-fabricd
ReadWritePaths=/etc/zyvor-fabricd
ReadWritePaths=/etc/systemd/network
ReadWritePaths=/run/systemd/machines
ReadWritePaths=-/run/systemd/nspawn
ReadWritePaths=/tmp
StateDirectory=zyvor-fabricd
ConfigurationDirectory=zyvor-fabricd
LogsDirectory=zyvor-fabricd
RuntimeDirectory=zyvor-fabricd

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectControlGroups=no
# NOT RestrictSUIDSGID: zyvor-fabricd spawns supervised helper children
# (dnsmasq for per-bridge DHCP, swtpm, ...) that call setuid/setgid during
# their own normal startup even when the target id matches the current one
# (e.g. dnsmasq's --user=root/--group=root still issues the syscalls, not
# skipped just because it's a same-id no-op). RestrictSUIDSGID applies a
# seccomp filter blocking that unconditionally regardless of capabilities,
# so it broke DHCP server startup outright — removing it, together with
# adding CAP_SETUID/CAP_SETGID below (both gate the same syscalls, at the
# capability layer rather than seccomp; both had to give way), is what
# actually fixes it. Limited additional protection lost either way given
# this unit already runs as full root with CAP_SYS_ADMIN/CAP_DAC_OVERRIDE,
# both far more powerful than what restricting setuid/setgid adds as
# defense-in-depth.
RemoveIPC=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=no
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native

# Capabilities required for VM management
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_RAW CAP_MKNOD CAP_SYS_PTRACE CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_RAW CAP_MKNOD CAP_SYS_PTRACE CAP_KILL CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=infinity
TasksMax=infinity

# OOM handling
OOMScoreAdjust=-900

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zyvor-fabricd

[Install]
WantedBy=multi-user.target
