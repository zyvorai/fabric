# PRODUCTION EXAMPLE -- copy, review, and bind-mount this over
# /etc/zyvor-fabricd/zyvor-fabricd.toml (see docker-compose.prod.example.yml).
# The image bakes in configs/zyvor-fabricd-docker.toml (the eval profile --
# auth on with a fixed eval password, TLS off) -- this file is what turns
# TLS on and replaces the fixed eval password; setting
# ZYVOR_FABRICD_JWT_SECRET/ZYVOR_FABRICD_ADMIN_PASSWORD alone does NOT turn
# TLS on, that's the [tls] section below.

[daemon]
listen = "0.0.0.0:9095"
# cors_origins = ["https://fabric.example.com"]

[storage]
path = "/var/lib/zyvor-fabricd"
image_path = "/var/lib/zyvor-fabricd/images"

[network]
bridge = "br0"

[auth]
enabled = true
# jwt_secret and default_admin_password are read from the
# ZYVOR_FABRICD_JWT_SECRET / ZYVOR_FABRICD_ADMIN_PASSWORD env vars
# (see docker-compose.prod.example.yml) -- leave both unset here.

[tls]
enabled = true
# cert_path / key_path default to /etc/zyvor-fabricd/tls/{server.crt,server.key}
# and are auto-generated (self-signed) on first start if missing. Replace
# with a real certificate for anything beyond an internal network.

[driver]
fluxvm_url = "http://127.0.0.1:7788"
