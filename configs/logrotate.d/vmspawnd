# Logrotate configuration for vmspawnd
# Installed to /etc/logrotate.d/vmspawnd
#
# journald handles the main service logs, but this covers
# any file-based logs from backup/cleanup scripts.

/var/log/vmspawnd/*.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
}
