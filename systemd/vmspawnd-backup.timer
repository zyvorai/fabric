[Unit]
Description=vmspawnd Daily VM Backup Timer
Documentation=https://github.com/ssahani/vmspawn

[Timer]
# Run daily at 2:00 AM
OnCalendar=*-*-* 02:00:00
# Randomize start by up to 30 minutes to avoid thundering herd
RandomizedDelaySec=1800
# Run missed backups on next boot if timer was missed
Persistent=true
# Don't run if system just booted (wait 5 min)
OnBootSec=5min

[Install]
WantedBy=timers.target
