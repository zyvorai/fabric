# Example only — do not ship a known default password.
# Prefer:
#   ./scripts/k8s-set-admin-secret.sh --apply
#   FABRIC_LAB_DEFAULTS=1 ./scripts/k8s-set-admin-secret.sh --apply
#   FABRIC_ADMIN_PASSWORD='YOUR_PASSWORD' ./scripts/k8s-set-admin-secret.sh --apply
#
# Or:
#   kubectl create secret generic zyvor-fabric-secrets \
#     --from-literal=admin-username=admin \
#     --from-literal=admin-password='YOUR_PASSWORD' \
#     --from-literal=jwt-secret="$(openssl rand -base64 32)" \
#     -n zyvor-fabric
apiVersion: v1
kind: Secret
metadata:
  name: zyvor-fabric-secrets
  namespace: zyvor-fabric
  labels:
    app: zyvor-fabric
type: Opaque
stringData:
  admin-username: "admin"
  admin-password: "REPLACE_ME"
  jwt-secret: "change-me-to-a-long-random-string"
