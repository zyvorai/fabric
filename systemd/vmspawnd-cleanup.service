[Unit]
Description=vmspawnd State Store Cleanup
Documentation=https://github.com/ssahani/vmspawn
After=vmspawnd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/vmspawnd/cleanup-store
TimeoutStartSec=300

User=root
Group=root

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vmspawnd

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vmspawnd-cleanup
